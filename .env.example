# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority

# Database name (optional)
MONGODB_DB=boutique

# JWT signing secret — use a long random string (min 16 characters)
AUTH_SECRET=replace-with-a-long-random-secret-key

# First admin user (used by: npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Shop name shown in WhatsApp reminder messages (optional)
NEXT_PUBLIC_SHOP_NAME=My Boutique
